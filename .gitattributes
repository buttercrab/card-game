# Eval suites name their files by SHA-256, so checkouts must keep them byte
# for byte (no CRLF on Windows).
research/evals/** -text

# The parity fixtures are generated (python -m cardgame_ml.export.fixture);
# diffs of them mean nothing to read.
crates/infer/tests/tiny/** -text -diff linguist-generated
crates/infer/tests/tiny-q/** -text -diff linguist-generated

# Generated from the server's types (crates/server/src/codegen.rs), which
# a test compares byte for byte.
web/src/lib/generated/** text eol=lf linguist-generated
